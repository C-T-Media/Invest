# Postgres connection string (e.g. from Neon, Supabase, or a local instance)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Comma-separated list of email addresses that get admin access
ADMIN_EMAILS="you@example.com"

# Secret used to sign session cookies - change this in production!
SESSION_SECRET="change-me-to-a-long-random-string"

# SMTP settings for sending login codes. If unset, codes are logged to the
# server console instead (useful for local development).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="user@example.com"
# SMTP_PASSWORD="changeme"
# SMTP_FROM="Community Invest <no-reply@example.com>"
